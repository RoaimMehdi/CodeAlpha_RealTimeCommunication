# Server
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=localhost
DB_USER=meetroom
DB_PASSWORD=your_mysql_password
DB_NAME=meetroom

# CORS (same origin in dev, production domain in prod)
CORS_ORIGIN=http://localhost:3001

# LiveKit (SFU) - secrets stay on the backend only
LIVEKIT_URL=https://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TTL=1h

# TURN (optional, needed across restrictive NATs)
TURN_URL=turn:your-turn-server:3478
TURN_USER=your-turn-username
TURN_PASSWORD=your-turn-password
