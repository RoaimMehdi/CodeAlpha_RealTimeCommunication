{
  "name": "meetroom",
  "version": "1.1.0",
  "private": true,
  "description": "Browser-based video meetings with chat, whiteboard and file sharing.",
  "main": "server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node scripts/setup-db.js",
    "health": "node -e \"fetch('http://localhost:'+(process.env.PORT||9000)+'/api/health').then(r=>r.json()).then(j=>{console.log(JSON.stringify(j,null,2));process.exit(j.status==='ok'?0:1)}).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "socket.io": "^4.7.5"
  }
}
