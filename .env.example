# ---------------------------------------------------------------------------
# MeetRoom environment
# Copy to .env and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# HTTP server
PORT=9000
# 16+ characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=meetroom
DB_PASSWORD=change-me
DB_NAME=meetroom

# Limits
MAX_PARTICIPANTS=6
MAX_UPLOAD_MB=25
DB_POOL=10

# Leave empty for same-origin only. Comma-separate multiple origins.
# Example: CORS_ORIGIN=https://meet.example.com
CORS_ORIGIN=

# Set to 1 only when running behind a reverse proxy (nginx, Caddy, Docker)
TRUST_PROXY=0
